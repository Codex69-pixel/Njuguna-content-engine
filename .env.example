# ============ 1. SCRIPT WRITER (pick ONE) ============
# "ollama" = free, runs on your PC.  "gemini" = free API key, better writing, needs internet.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============ 2. CLIPS ============
# Free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# ============ 3. VOICE (free AI voice) ============
# Kenyan English: en-KE-AsiliaNeural (female) or en-KE-ChilembaNeural (male)
TTS_VOICE=en-KE-AsiliaNeural
# Speed. +8% sounds a bit more energetic. Use 0% for normal, -5% for calmer.
TTS_RATE=+8%

# ============ 4. WHATSAPP (where videos get sent to YOU) ============
# From developers.facebook.com -> your app -> WhatsApp -> API Setup
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Your personal WhatsApp number with country code, digits only, e.g. 2547XXXXXXXX
WA_OWNER_NUMBER=
# Any secret word you invent. You'll paste the same word into the Meta webhook settings.
WA_VERIFY_TOKEN=pick-a-secret-word
# App secret (Meta app -> App settings -> Basic). Makes sure only Meta can talk to your webhook.
WA_APP_SECRET=
# Message used to wake the chat up when 24h have passed since you last messaged the bot.
# "hello_world" works out of the box on the test number. See README to make a nicer one.
WA_TEMPLATE_NAME=hello_world
WA_TEMPLATE_LANG=en_US

# ============ 5. YOUR PUBLIC ADDRESS (from ngrok) ============
PORT=3000
PUBLIC_URL=https://your-name.ngrok-free.app
# Any random string. Protects the video links Instagram downloads from.
MEDIA_KEY=make-up-a-long-random-string

# ============ 6. AUTOPILOT SETTINGS ============
# How many new videos to prepare every night for you to review
VIDEOS_PER_DAY=3
# Nightly build time (Nairobi time). 0 2 * * * = 02:00
GENERATE_CRON=0 2 * * *
# Morning check-in message time. 30 7 * * * = 07:30
DIGEST_CRON=30 7 * * *
# When approved videos go out (Nairobi time, 24h clock, comma separated)
POST_TIMES=08:00,13:00,19:00
# Stop making new videos when this many are already waiting for your review
MAX_PENDING_REVIEW=6

# ============ 7. YOUR DETAILS (added to every caption automatically) ============
CONTACT_WHATSAPP=254792629643
CONTACT_EMAIL=njugunacyua@gmail.com
CONTACT_WEBSITE=
# Text shown on screen at the very end of each video
OUTRO_TEXT=Njuguna Devs - websites that work for you

# ============ 8. OPTIONAL: AUTO-POST TO INSTAGRAM + FACEBOOK (do this later, see README Part 8) ============
AUTO_POST_META=false
META_PAGE_TOKEN=
IG_USER_ID=
FB_PAGE_ID=
